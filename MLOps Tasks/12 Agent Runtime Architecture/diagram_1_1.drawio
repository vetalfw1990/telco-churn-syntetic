        <mxCell id="bf" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff8f1;strokeColor=#e0b48a;fontSize=11;align=left;spacingLeft=10;" value="Файлова система&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#5b6a68&#39;&gt;права ОС&lt;/font&gt;" vertex="1">
