        <mxCell id="sf" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8f1;strokeColor=#b4540a;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;MCP Server · Local codebase&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#5b6a68&#39;&gt;локальний процес на тій самій машині&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tools:&lt;/b&gt; read_file, list_directory&lt;br&gt;&lt;b&gt;Resources:&lt;/b&gt; file:///{path}" vertex="1">
          <mxGeometry height="120" width="310" x="620" y="560" as="geometry" />
