        <mxCell id="e4" edge="1" parent="1" source="cd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b4540a;strokeWidth=2;fontSize=11;fontStyle=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" target="sf" value="stdio&amp;#10;дочірній процес">
