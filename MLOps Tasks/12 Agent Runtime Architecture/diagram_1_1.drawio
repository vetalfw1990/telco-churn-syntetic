        <mxCell id="sg" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ab3ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;MCP Server · GitHub&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#5b6a68&#39;&gt;віддалений SaaS, читання issues&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tools:&lt;/b&gt; search_issues, get_issue&lt;br&gt;&lt;b&gt;Resources:&lt;/b&gt; issue://{repo}/{id}&lt;br&gt;&lt;b&gt;Prompts:&lt;/b&gt; triage_issue" vertex="1">
          <mxGeometry height="120" width="310" x="620" y="110" as="geometry" />
        </mxCell>
        <mxCell id="sj" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ab3ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;MCP Server · Jira&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#5b6a68&#39;&gt;віддалений SaaS, створення тікетів&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tools:&lt;/b&gt; create_ticket, update_status&lt;br&gt;&lt;b&gt;Prompts:&lt;/b&gt; bug_template&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#b4540a&#39;&gt;дія зі світом → потрібна ідемпотентність&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="620" y="250" as="geometry" />
        </mxCell>
        <mxCell id="ss" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ab3ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" value="&lt;b&gt;MCP Server · Slack&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px;color:#5b6a68&#39;&gt;віддалений SaaS, надсилання повідомлень&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Tools:&lt;/b&gt; send_message&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#b4540a&#39;&gt;незворотна дія → підтвердження людини&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="620" y="390" as="geometry" />
