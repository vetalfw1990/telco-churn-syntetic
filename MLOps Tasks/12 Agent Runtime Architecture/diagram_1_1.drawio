        <mxCell id="bs" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef4f2;strokeColor=#c3d5d1;fontSize=11;align=left;spacingLeft=10;" value="Slack Web API&lt;br&gt;&lt;font style=&#39;font-size:10px;color:#5b6a68&#39;&gt;OAuth, TLS&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="180" x="1010" y="425" as="geometry" />
