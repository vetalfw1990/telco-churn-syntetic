      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=18;" value="&lt;b&gt;MCP: AI-асистент команди розробки&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:11px&#39;&gt;Host запускає по одному Client на кожен Server. Транспорт обирається за тим, ДЕ сервер виконується.&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="800" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="host" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f4f8f7;strokeColor=#9ab3ae;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" value="HOST — IDE / чат-застосунок" vertex="1">
